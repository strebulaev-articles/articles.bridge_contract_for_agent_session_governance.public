{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/events/CLIENT_JOINED.schema.json",
  "title": "CLIENT_JOINED payload",
  "x-invariants": "I15",
  "description": "An authentic request from a registered key while attached; carries the acknowledged (seq, hash).",
  "type": "object",
  "properties": {
    "key_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonce_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,64}$",
      "description": "Hex digest, truncated to at least 64 bits."
    }
  },
  "required": [
    "key_id",
    "seq",
    "hash",
    "nonce_digest"
  ],
  "additionalProperties": false
}
