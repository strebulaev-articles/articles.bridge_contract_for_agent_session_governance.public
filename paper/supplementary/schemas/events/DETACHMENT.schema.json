{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/events/DETACHMENT.schema.json",
  "title": "DETACHMENT payload",
  "x-invariants": "I1",
  "description": "Last connected client left, the bridge restarted, or a revocation removed the last connected key or the key whose re-attach was being verified.",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "client_disconnect",
        "bridge_restart",
        "key_revoked"
      ],
      "description": "Reason code."
    }
  },
  "required": [
    "reason"
  ],
  "additionalProperties": false
}
