{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/events/RESUME_PREPARED.schema.json",
  "title": "RESUME_PREPARED payload",
  "x-invariants": "I1",
  "description": "The bridge's own resume record; nothing is delivered to the client.",
  "type": "object",
  "properties": {
    "authority_hash": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "client_disconnect",
        "bridge_restart",
        "key_revoked"
      ],
      "description": "Reason code."
    },
    "authority_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scope_version": {
      "type": "integer",
      "minimum": 0
    },
    "pending_tool_calls": {
      "type": "array"
    }
  },
  "required": [
    "authority_hash",
    "reason",
    "authority_scope",
    "scope_version",
    "pending_tool_calls"
  ],
  "additionalProperties": false
}
