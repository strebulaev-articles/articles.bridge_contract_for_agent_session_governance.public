{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/messages/attach.response.schema.json",
  "title": "Wire response: attach",
  "type": "object",
  "properties": {
    "status": {
      "const": "attached"
    },
    "session_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "const": 0,
      "description": "Genesis sequence number."
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the genesis ATTACHED event."
    }
  },
  "required": [
    "status",
    "session_id",
    "seq",
    "hash"
  ],
  "additionalProperties": false
}
