{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/messages/reattach.schema.json",
  "title": "Wire op: reattach",
  "type": "object",
  "properties": {
    "op": {
      "const": "reattach"
    },
    "session_id": {
      "type": "string"
    },
    "key_id": {
      "type": "string"
    },
    "nonce": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "hash": {
      "type": "string"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]+$",
      "description": "Signature by key_id over canonical JSON of [\"bc/v1/reattach\", session_id, key_id, nonce, seq, hash]."
    }
  },
  "required": [
    "op",
    "session_id",
    "key_id",
    "nonce",
    "seq",
    "hash",
    "signature"
  ],
  "additionalProperties": false
}
