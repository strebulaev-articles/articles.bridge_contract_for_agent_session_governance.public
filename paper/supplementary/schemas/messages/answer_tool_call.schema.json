{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/messages/answer_tool_call.schema.json",
  "title": "Wire op: answer_tool_call",
  "type": "object",
  "properties": {
    "op": {
      "const": "answer_tool_call"
    },
    "session_id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "shown_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "h_a: hash of the content the client displayed."
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "deny"
      ]
    }
  },
  "required": [
    "op",
    "session_id",
    "key",
    "shown_hash",
    "decision"
  ],
  "additionalProperties": false
}
