{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/messages/extend.response.schema.json",
  "title": "Wire response: extend",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "rejected",
        "revert_requested",
        "unchanged"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "reason": {
      "const": "extension_rejected",
      "description": "Present with status rejected: a widening asked for through the bridge (I3)."
    },
    "current_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "session_id",
    "current_scope"
  ],
  "additionalProperties": false
}
