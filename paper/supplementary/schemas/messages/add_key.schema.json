{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/messages/add_key.schema.json",
  "title": "Wire op: add_key",
  "type": "object",
  "properties": {
    "op": {
      "const": "add_key"
    },
    "session_id": {
      "type": "string"
    },
    "key_id": {
      "type": "string"
    },
    "scheme": {
      "type": "string"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]+$",
      "description": "Operator signature over canonical JSON of [\"bc/v1/add-key\", bridge_id, session_id, key_id, scheme, public_key, seq, head]."
    }
  },
  "required": [
    "op",
    "session_id",
    "key_id",
    "scheme",
    "public_key"
  ],
  "additionalProperties": false
}
