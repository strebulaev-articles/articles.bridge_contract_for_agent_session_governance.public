{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bridge-contract/schemas/event.schema.json",
  "title": "Bridge Contract governance event",
  "description": "Envelope of one governance event. `prev_hash` is the SHA-256 of the canonical JSON (RFC 8785) of the preceding event, empty for the genesis event (I5). The event's own hash is derived, not a field.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "ATTACHED",
        "CLIENT_JOINED",
        "CLIENT_LEFT",
        "CLIENT_ADDED",
        "DETACHMENT",
        "RESUME_PREPARED",
        "RESUME_STARTED",
        "RESUME_REJECTED",
        "RESUME_VERIFIED",
        "RESUME_FAILED",
        "HUMAN_PENDING",
        "HUMAN_RESOLVED",
        "HUMAN_TIMEOUT",
        "DETACH_TIMEOUT",
        "AUTHORITY_EXTENSION_REJECTED",
        "AUTHORITY_NARROWED",
        "AUTHORITY_NARROWING_REJECTED",
        "TERMINATION",
        "TOOL_CALL_QUEUED",
        "TOOL_CALL_ANSWERED",
        "TOOL_CALL_DRAINED",
        "TOOL_CALL_DELIVERED",
        "TOOL_CALL_COMPLETED",
        "TOOL_CALL_REJECTED",
        "TOOL_CALL_EXPIRED",
        "BRIDGE_RECOVERED",
        "RECOVERY_FAILED",
        "CHECKPOINT",
        "KEY_REVOKED",
        "KEY_REVOCATION_REQUESTED",
        "OPERATOR_ADD_KEY",
        "OPERATOR_TERMINATION"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per session, 0 at genesis."
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "payload": {
      "type": "object"
    },
    "timestamp": {
      "type": "number",
      "description": "Informational; never used for ordering."
    }
  },
  "required": [
    "kind",
    "session_id",
    "sequence",
    "prev_hash",
    "payload",
    "timestamp"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ATTACHED"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "events/ATTACHED.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CLIENT_JOINED"
          }
        },
