    },
    {
      "do": "reattach",
      "client": "ck-1",
      "error": true
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "CLIENT_ADDED",
      "KEY_REVOKED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "RESUME_REJECTED"
    ],
    "cell": [
      "Det",
      "None"
    ],
    "scope_version": 0,
    "clients": [],
    "revoked": [
      "ck-1"
    ],
    "key_exhausted": false
  }
}
