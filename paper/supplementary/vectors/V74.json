{
  "id": "V74",
  "title": "Soft revocation of the only connected key keeps it in the client set until it disconnects, then it cannot re-attach",
  "covers": [
    "I11-REVOKE",
    "I15"
  ],
  "session": {
    "session_id": "sess-74",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "add_client",
      "client": "ck-2"
    },
    {
      "do": "revoke",
      "client": "ck-1",
      "reason": "rotation"
    },
    {
      "do": "disconnect",
