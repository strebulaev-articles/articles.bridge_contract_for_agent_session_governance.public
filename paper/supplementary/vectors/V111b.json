{
  "id": "V111b",
  "title": "Revoking by rotation the only key while its re-attach is verified abandons the re-attach; the session then ends at T_detach",
  "covers": [
    "I11-REVOKE",
    "L1",
    "IRev"
  ],
  "config": {
    "t_detach": 600
  },
  "session": {
    "session_id": "sess-111b",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "disconnect"
    },
    {
      "do": "reattach",
      "complete": false,
      "then_cell": [
        "Res",
        "None"
      ]
    },
    {
      "do": "revoke",
      "client": "ck-1",
      "reason": "rotation",
      "then_cell": [
        "Det",
        "None"
      ]
    },
    {
      "do": "complete_resume",
      "error": true
    },
    {
      "do": "advance",
      "seconds": 600
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "RESUME_STARTED",
      "KEY_REVOKED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "DETACH_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0,
    "clients": [],
    "revoked": [
      "ck-1"
    ],
    "key_exhausted": true
  }
}
