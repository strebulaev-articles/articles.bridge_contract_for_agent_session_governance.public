{
  "id": "V116",
  "title": "A restart treats a key-exhausted session like any other: T_detach restarts and the session ends",
  "covers": [
    "I11-REVOKE",
    "L1",
    "I12"
  ],
  "config": {
    "t_detach": 600
  },
  "session": {
    "session_id": "sess-116",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "revoke",
      "client": "ck-1",
      "reason": "compromise"
    },
    {
      "do": "advance",
      "seconds": 400
    },
    {
      "do": "restart"
    },
    {
      "do": "advance",
      "seconds": 599,
      "then_cell": [
        "Det",
        "None"
      ]
    },
    {
      "do": "advance",
      "seconds": 1
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "KEY_REVOKED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "BRIDGE_RECOVERED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "DETACH_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0,
    "last_event_payload": {
      "reason": "detach_timeout"
    },
    "revoked": [
      "ck-1"
    ],
    "key_exhausted": true
  }
}
