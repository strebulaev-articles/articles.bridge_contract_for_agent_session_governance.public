{
  "id": "V62c",
  "title": "A re-attach refused on a key-exhausted session is refused again after the operator adds its key",
  "covers": [
    "I11",
    "I11-REVOKE"
  ],
  "session": {
    "session_id": "sess-62c",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "revoke",
      "client": "ck-1",
      "reason": "compromise"
    },
    {
      "do": "reattach",
      "client": "ck-2",
      "as": "r1",
      "error": true,
      "wire_reason": "bad_signature",
      "log_reason": "unknown_key"
    },
    {
      "do": "reattach",
      "client": "ck-1",
      "error": true,
      "wire_reason": "revoked_key",
      "log_reason": "revoked_key"
    },
    {
      "do": "operator_add_key",
      "client": "ck-2"
    },
    {
      "do": "reattach",
      "replay_of": "r1",
      "error": true,
      "wire_reason": "bad_signature",
      "log_reason": "nonce_binding"
    },
    {
      "do": "reattach",
      "client": "ck-2"
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "KEY_REVOKED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "RESUME_REJECTED",
      "RESUME_REJECTED",
      "OPERATOR_ADD_KEY",
      "RESUME_REJECTED",
      "RESUME_STARTED",
      "RESUME_VERIFIED"
    ],
    "cell": [
      "Att",
      "None"
    ],
    "scope_version": 0,
    "clients": [
      "ck-2"
    ],
    "revoked": [
      "ck-1"
    ],
    "key_exhausted": false
  }
}
