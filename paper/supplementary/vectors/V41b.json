{
  "id": "V41b",
  "title": "An approval that lapsed is not revived by the resolution of a later escalation",
  "covers": [
    "I13",
    "I14"
  ],
  "config": {
    "t_approve": 100,
    "t_detach": 10000
  },
  "session": {
    "session_id": "sess-41b",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "escalate"
    },
    {
      "do": "disconnect"
    },
    {
      "do": "tool_call",
      "key": "k1",
      "tool": "shell:git push"
    },
    {
      "do": "resolve"
    },
    {
      "do": "advance",
      "seconds": 150
    },
    {
      "do": "escalate"
    },
    {
      "do": "tool_call",
      "key": "k2",
      "tool": "shell:ls"
    },
    {
      "do": "resolve"
    },
    {
      "do": "advance",
      "seconds": 50
    },
    {
      "do": "reattach"
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "HUMAN_PENDING",
      "DETACHMENT",
      "RESUME_PREPARED",
      "TOOL_CALL_QUEUED",
      "TOOL_CALL_ANSWERED",
      "HUMAN_RESOLVED",
      "HUMAN_PENDING",
      "TOOL_CALL_QUEUED",
      "TOOL_CALL_ANSWERED",
      "HUMAN_RESOLVED",
      "RESUME_STARTED",
      "RESUME_VERIFIED",
      "TOOL_CALL_EXPIRED",
      "TOOL_CALL_DRAINED"
    ],
    "cell": [
      "Att",
      "None"
    ],
    "scope_version": 0,
    "forwarded": [
      "k2"
    ],
    "queue": []
  }
}
