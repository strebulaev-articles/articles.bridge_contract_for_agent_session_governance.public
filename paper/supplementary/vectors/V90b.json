{
  "id": "V90b",
  "title": "A join on a detached session: unverified it is a bad signature, verified it is refused as not_attached and starts no re-attach",
  "covers": [
    "I11",
    "I11a",
    "I15"
  ],
  "session": {
    "session_id": "sess-90b",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "add_client",
      "client": "ck-2"
    },
    {
      "do": "disconnect"
    },
    {
      "do": "join",
      "client": "ck-2",
      "proof": "invalid",
      "error": true,
      "wire_reason": "bad_signature",
      "log_reason": "bad_signature"
    },
    {
      "do": "join",
      "client": "ck-2",
      "as": "r1",
      "error": true,
      "wire_reason": "not_attached",
      "log_reason": "not_attached"
    },
    {
      "do": "join",
      "replay_of": "r1",
      "error": true,
      "wire_reason": "nonce_used",
      "log_reason": "nonce_used"
    },
    {
      "do": "reattach",
      "client": "ck-2"
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "CLIENT_ADDED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "RESUME_REJECTED",
      "RESUME_REJECTED",
      "RESUME_REJECTED",
      "RESUME_STARTED",
      "RESUME_VERIFIED"
    ],
    "cell": [
      "Att",
      "None"
    ],
    "scope_version": 0,
    "clients": [
      "ck-2"
    ]
  }
}
