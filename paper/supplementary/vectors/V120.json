{
  "id": "V120",
  "title": "A key-exhausted session whose client stays connected has no timer until the transport is lost, then it ends after T_detach",
  "covers": [
    "I11-REVOKE",
    "L1",
    "I15"
  ],
  "config": {
    "t_detach": 600
  },
  "session": {
    "session_id": "sess-120",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "revoke",
      "client": "ck-1",
      "reason": "rotation"
    },
    {
      "do": "advance",
      "seconds": 5000,
      "then_cell": [
        "Att",
        "None"
      ]
    },
    {
      "do": "escalate",
      "error": true
    },
    {
      "do": "disconnect"
    },
    {
      "do": "advance",
      "seconds": 599,
      "then_cell": [
        "Det",
        "None"
      ]
    },
    {
      "do": "advance",
      "seconds": 1
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "KEY_REVOKED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "DETACH_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0,
    "last_event_payload": {
      "reason": "detach_timeout"
    },
    "revoked": [
      "ck-1"
    ],
    "key_exhausted": true
  }
}
