{
  "id": "V16c",
  "title": "A re-attach refused in the tick in which T_detach expires: the timer fires after it",
  "covers": [
    "L1",
    "I11"
  ],
  "config": {
    "t_detach": 600
  },
  "session": {
    "session_id": "sess-16c",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "disconnect"
    },
    {
      "do": "advance",
      "seconds": 600,
      "tick": false
    },
    {
      "do": "reattach",
      "proof": "invalid",
      "error": true,
      "wire_reason": "bad_signature"
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "RESUME_REJECTED",
      "DETACH_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0
  }
}
