{
  "id": "V119",
  "title": "A pending escalation on a key-exhausted session still times out",
  "covers": [
    "I11-REVOKE",
    "L2",
    "TIMERS"
  ],
  "config": {
    "t_detach": 3600,
    "t_human": 600
  },
  "session": {
    "session_id": "sess-119",
    "principal_id": "user-alice",
    "authority_scope": [
      "read:docs",
      "exec:shell"
    ],
    "client_key_id": "ck-1"
  },
  "actions": [
    {
      "do": "escalate"
    },
    {
      "do": "revoke",
      "client": "ck-1",
      "reason": "compromise"
    },
    {
      "do": "advance",
      "seconds": 599,
      "then_cell": [
        "Det",
        "Pend"
      ]
    },
    {
      "do": "advance",
      "seconds": 1
    }
  ],
  "expect": {
    "events": [
      "ATTACHED",
      "HUMAN_PENDING",
      "KEY_REVOKED",
      "DETACHMENT",
      "RESUME_PREPARED",
      "HUMAN_TIMEOUT",
      "TERMINATION"
    ],
    "cell": [
      "Terminated"
    ],
    "scope_version": 0,
    "last_event_payload": {
      "reason": "human_timeout"
    },
    "revoked": [
      "ck-1"
    ],
    "key_exhausted": true
  }
}
